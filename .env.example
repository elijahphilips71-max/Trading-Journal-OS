# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (login, database, screenshots) ---
# Supabase dashboard > Project Settings > API Keys. These two are safe for the browser.
# Use the URL without "/rest/v1". The key is the "publishable" key (sb_publishable_...) or the older anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Paste this into your hosting settings yourself (Vercel > Settings > Environment Variables).
# Never put it in chat or git. Used only by Dad's share page and scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

# The address the app is served from (used in login emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI coach (Claude API), server only ---
ANTHROPIC_API_KEY=
# Optional: which Claude model the coach uses, and a daily cap on coach replies.
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=40

# --- Earnings dates for "Trade today?", server only ---
# Free key from finnhub.io (Dashboard > API key). Paste it into Vercel yourself, never in chat.
MARKET_DATA_API_KEY=
